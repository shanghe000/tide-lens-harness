{
  "name": "dsh-tide-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tide Lens — DeepSeek Harness 的永续合约研究看板",
  "main": "./harness-host.mjs",
  "exports": {
    ".": "./harness-host.mjs",
    "./client": "./harness-client.js",
    "./package.json": "./package.json"
  },
  "files": ["cordis.patch.yml", "harness-host.mjs", "harness-client.js", "server.mjs", "market.mjs", "models.mjs", "reviews.mjs", "advanced.mjs", "ui"],
  "engines": { "node": ">=24.9", "dsh": ">=0.2.2-rc.1 <0.2.3-0" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3-0" },
  "scripts": { "start": "node --use-env-proxy server.mjs", "test": "node --test tests/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    },
    "meta": { "title": "Tide Lens 行情透镜" }
  }
}
